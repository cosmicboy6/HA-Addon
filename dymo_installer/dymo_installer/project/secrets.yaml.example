# Copy this file to secrets.yaml (which is gitignored) and fill in your values.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback captive-portal AP (used when the WiFi above is unreachable)
ap_ssid: "DYMO Print Fallback"
ap_password: "CHANGE_ME_AT_LEAST_8_CHARS"

# API encryption key. Generate one with:
#   openssl rand -base64 32
# or let ESPHome create it (esphome wizard).
api_encryption_key: "GENERATE_WITH_openssl_rand_base64_32"
